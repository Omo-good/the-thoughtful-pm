# Copy to .env.local for local development. Never commit real values.

# Public site URL used for canonical links, Open Graph and the sitemap.
# Change this when a custom domain is approved.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact details. Leave empty to hide them from the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=

# SERVER-ONLY. Formspree form endpoint, e.g. https://formspree.io/f/xxxxxxxx.
# Leave empty and the contact form shows the email fallback instead of sending.
FORMSPREE_ENDPOINT=
